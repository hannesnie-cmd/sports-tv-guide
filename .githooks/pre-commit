#!/bin/sh
# Blocks commits that contain IPTV credentials, server URLs or playlists.
# Enable once per clone:  git config core.hooksPath .githooks
files=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$files" ] && exit 0
# shellcheck disable=SC2086
exec python3 tools/check_secrets.py $files
